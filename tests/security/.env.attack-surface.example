# Attack-surface regression suite — staging credential bundle.
#
# Copy to .env.attack-surface (gitignored) and fill in real values.
# See tests/security/PERSONAS.md for one-time staging account setup.
#
# Run with:
#   set -a; source .env.attack-surface; set +a
#   pytest tests/security/test_attack_surface.py -v -m live
#
# A missing PERSONA_<NAME>_USERNAME/PASSWORD pair skips that persona
# from the matrix without failing the suite.

# --- Target environment ---
TEST_BASE_URL=https://<staging-host>

# --- Chart-data statistic keys (optional overrides) ---
# These are statistic keys from _MAP_STATISTICS in
# bin/python/asset_management/web/blueprints/dashboard_builder/routes.py
# (search for `_MAP_STATISTICS = {`). One per importer family — the
# suite spot-checks each family's es.search wrap. Override only if your
# staging has renamed or removed one of the defaults.
#
# Available keys today (data_source in parens):
#   reach (fb_insights), app_installs (fb_insights), page_visits (fb_insights),
#   video_views (fb_insights), messages (echo), echo_multiplier (echo),
#   messaging_contacts (echo), messages_sent (echo), spiritual_convos_echo (echo),
#   google_ads_app_installs (google_ads), baptisms (dt), dt_contacts (dt),
#   multiplier_contacts (dt), salvation (dt), spiritual_conversations (dt),
#   first_meetings (dt), new_groups (dt), new_churches (dt)
TEST_CHART_STAT_FACEBOOK=reach
TEST_CHART_STAT_ECHO=messages
TEST_CHART_STAT_GOOGLE_ADS=google_ads_app_installs
TEST_CHART_STAT_DT=baptisms

# -- cross-tenant target team esid ---
# Esid (de_asset_teams _id) of an out-of-workspace team (Team B1 in
# workspace-b) the A-scoped personas must never be able to configure or read.
# The connector configure gate (TestConnectorConfigureTenantScope) POSTs this
# esid and expects a 404; the NLQ-scope surface uses it as the cross-tenant
# probe. The seeder resolves "Team B1" -> esid and fills this in on --apply.
# Leave empty and those two surfaces record SKIP (a missing target must never
# read as a green) rather than ERROR.
TEST_FORBIDDEN_TEAM_ESID=

# --- bare (no scope, deny-all floor check) ---
PERSONA_BARE_USERNAME=
PERSONA_BARE_PASSWORD=
PERSONA_BARE_FORBIDDEN_ORGS=
PERSONA_BARE_FORBIDDEN_TEAMS=
PERSONA_BARE_FORBIDDEN_WORKSPACES=
PERSONA_BARE_EXPECTS_EMPTY_SCOPE=true

# --- workspace_admin (single-workspace admin) ---
PERSONA_WORKSPACE_ADMIN_USERNAME=
PERSONA_WORKSPACE_ADMIN_PASSWORD=
PERSONA_WORKSPACE_ADMIN_ALLOWED_WORKSPACES=
PERSONA_WORKSPACE_ADMIN_FORBIDDEN_WORKSPACES=
PERSONA_WORKSPACE_ADMIN_FORBIDDEN_ORGS=
PERSONA_WORKSPACE_ADMIN_FORBIDDEN_TEAMS=
PERSONA_WORKSPACE_ADMIN_CAN_SEE_USER_MANAGEMENT=true
# comma-separated connector-asset TITLES owned by a workspace
# OUTSIDE this admin's scope (e.g. the control workspace's Echo tenant /
# Google Ads customer / FB account titles). The Data Connectors picker
# surface (TestDataConnectorsPicker) scans for these; if any appears in
# /api/wizard/options/<type> the workspace narrowing leaked. Leave empty
# and the picker cells record SKIP (vacuous — nothing to detect) rather
# than a misleading PASS.
PERSONA_WORKSPACE_ADMIN_FORBIDDEN_ASSET_TITLES=

# --- org_user (single org membership) ---
PERSONA_ORG_USER_USERNAME=
PERSONA_ORG_USER_PASSWORD=
PERSONA_ORG_USER_ALLOWED_ORGS=
PERSONA_ORG_USER_FORBIDDEN_ORGS=
PERSONA_ORG_USER_FORBIDDEN_TEAMS=

# --- team_user (single team membership) ---
PERSONA_TEAM_USER_USERNAME=
PERSONA_TEAM_USER_PASSWORD=
PERSONA_TEAM_USER_ALLOWED_TEAMS=
PERSONA_TEAM_USER_FORBIDDEN_TEAMS=
PERSONA_TEAM_USER_FORBIDDEN_ORGS=

# -- grant_user (workspace-scoped data grant; path) ---
PERSONA_GRANT_USER_USERNAME=
PERSONA_GRANT_USER_PASSWORD=
PERSONA_GRANT_USER_GRANTED_TEAMS=
PERSONA_GRANT_USER_ALLOWED_TEAMS=
PERSONA_GRANT_USER_FORBIDDEN_TEAMS=
PERSONA_GRANT_USER_FORBIDDEN_ORGS=

# --- superuser (sees all, by design) ---
PERSONA_SUPERUSER_USERNAME=
PERSONA_SUPERUSER_PASSWORD=
PERSONA_SUPERUSER_IS_SUPERUSER=true
PERSONA_SUPERUSER_CAN_SEE_USER_MANAGEMENT=true

# ─────────────────────────────────────────────────────────────────────
# expansion (2026-05-26): four new-authz cohort personas.
# Each persona has a `de_authz_user_*_role` row but NO membership doc
# the cohort shapes that surfaced as broken on
# prod. Live positive controls on the resolver fixes from those
# tickets.
# ─────────────────────────────────────────────────────────────────────

# -- team_grant ---
PERSONA_TEAM_GRANT_USERNAME=
PERSONA_TEAM_GRANT_PASSWORD=
PERSONA_TEAM_GRANT_ALLOWED_TEAMS=
PERSONA_TEAM_GRANT_FORBIDDEN_TEAMS=
PERSONA_TEAM_GRANT_FORBIDDEN_ORGS=

# -- workspace_member (workspace_member role_esid, no membership) ---
# Asserts workspace_member does NOT escalate to full workspace scope
# but still contributes their workspace_esid.
PERSONA_WORKSPACE_MEMBER_USERNAME=
PERSONA_WORKSPACE_MEMBER_PASSWORD=
PERSONA_WORKSPACE_MEMBER_ALLOWED_WORKSPACES=
PERSONA_WORKSPACE_MEMBER_FORBIDDEN_TEAMS=
PERSONA_WORKSPACE_MEMBER_FORBIDDEN_ORGS=
PERSONA_WORKSPACE_MEMBER_FORBIDDEN_ASSET_TITLES=  # (see workspace_admin note)

# --- org_grant (de_authz_user_org_role, no org_membership) ---
PERSONA_ORG_GRANT_USERNAME=
PERSONA_ORG_GRANT_PASSWORD=
PERSONA_ORG_GRANT_ALLOWED_ORGS=
PERSONA_ORG_GRANT_FORBIDDEN_ORGS=
PERSONA_ORG_GRANT_FORBIDDEN_TEAMS=

# --- workspace_grant (workspace_admin/workspace_owner role_esid, no membership) ---
PERSONA_WORKSPACE_GRANT_USERNAME=
PERSONA_WORKSPACE_GRANT_PASSWORD=
PERSONA_WORKSPACE_GRANT_ALLOWED_WORKSPACES=
PERSONA_WORKSPACE_GRANT_FORBIDDEN_WORKSPACES=
PERSONA_WORKSPACE_GRANT_FORBIDDEN_ORGS=
PERSONA_WORKSPACE_GRANT_FORBIDDEN_TEAMS=
PERSONA_WORKSPACE_GRANT_FORBIDDEN_ASSET_TITLES=  # (see workspace_admin note)

# ─────────────────────────────────────────────────────────────────────
# Shared second-factor seed
# ─────────────────────────────────────────────────────────────────────
# When set, the conftest answers /mfa/challenge by computing the
# current code from this seed and POSTing it (instead of relying on
# the break-glass bypass flag per account).
#
# Generate: run `python -m pyotp` (or `import pyotp; pyotp.random_base32()` in a REPL).
# Seed each persona account with this value in User Management →
# the account's MFA tab → admin override.
#
# Leave empty to keep the existing bypass-required behavior — the
# conftest falls back cleanly so legacy setups don't break.
PERSONA_SHARED_MFA_SECRET=
