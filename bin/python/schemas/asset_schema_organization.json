{
  "dynamic_templates": [
    {
      "strings_as_keyword": {
        "match_mapping_type": "string",
        "mapping": {
          "type": "keyword",
          "ignore_above": 8191
        }
      }
    }
  ],
  "properties": {
    "organization_title": {
      "type": "keyword"
    },
    "workspace_title": {
      "type": "keyword"
    },
    "workspace_esid": {
      "type": "keyword"
    },
    "organization_description": {
      "type": "text"
    },
    "organization_logo": {
      "type": "keyword"
    },
    "auto_join_email_domains": {
      "type": "keyword"
    }
  }
}
